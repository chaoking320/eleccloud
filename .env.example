# ElecCloud 环境变量配置示例
# 
# 使用方法：
# 1. 复制此文件为 .env
# 2. 根据实际环境修改配置值
# 3. 确保 .env 文件已加入 .gitignore

# ==================== MySQL配置 ====================
MYSQL_ROOT_PASSWORD=your_strong_password_here
MYSQL_DATABASE=retry_platform

# Spring Datasource
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_strong_password_here

# ==================== Redis配置 ====================
REDIS_PASSWORD=your_redis_password_here
SPRING_REDIS_PASSWORD=your_redis_password_here

# ==================== 安全配置 ====================
# API Key（用于客户端SDK认证）
RETRY_SECURITY_API_KEY=your-api-key-minimum-32-characters-long

# ==================== 应用配置 ====================
# Server端口
RETRY_SERVER_PORT=8080
RETRY_ADMIN_PORT=8081

# 日志级别
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_RETRY=DEBUG
